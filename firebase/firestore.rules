rules_version = '2';
// Rules for the Firestore REST client check only (run_firestore_client_test.sh).
// The real Firestore rules are a separate piece of work (collection layout S-7).
service cloud.firestore {
  match /databases/{database}/documents {
    match /client_check/{doc=**} {
      allow read, write: if request.auth != null;
    }
    match /client_check_gm/{doc=**} {
      allow read, write: if request.auth != null && request.auth.token.role == 'gm';
    }
  }
}
